+static void mw_protect(int on)
+{
+    DWORD old;
+    if (s_mw_page)
+        VirtualProtect((void *)s_mw_page, 4096, on ? (s_mw_rd ? PAGE_NOACCESS : PAGE_READONLY)
+                                                   : PAGE_READWRITE, &old);
