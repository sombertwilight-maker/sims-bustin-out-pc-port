+            memset(&c, 0, sizeof c);
+            c.ContextFlags = CONTEXT_FULL;
+            if (GetThreadContext(th, &c)) {
+                uintptr_t sp = (uintptr_t)c.Rsp, k;
+                int shown = 0;
+                fprintf(stderr, "[ENGINE-STUCK] %d s without progress: image %p rip %p rsp %p\n"
+                        "[ENGINE-STUCK]   stack:", stale, (void *)lo, (void *)c.Rip, (void *)sp);
