+static ProfEnt s_prof_self[PROF_N], s_prof_call[PROF_N];
+static void prof_add(ProfEnt *t, uintptr_t key)
+{
+    uint32_t h = (uint32_t)((key * 0x9E3779B97F4A7C15ull) >> 52) & (PROF_N - 1), i;
+    for (i = 0; i < 64; i++, h = (h + 1) & (PROF_N - 1)) {
+        if (t[h].key == key) { t[h].n++; return; }
+        if (!t[h].key) { t[h].key = key; t[h].n = 1; return; }
+    }
