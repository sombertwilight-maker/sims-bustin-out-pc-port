+static void prof_print(const char *what, ProfEnt *t, uint32_t total, int top, uintptr_t lo, uintptr_t hi)
+{
+    static ProfEnt c[PROF_N];
+    int n = 0, i;
+    for (i = 0; i < PROF_N; i++) if (t[i].key) c[n++] = t[i];
+    qsort(c, n, sizeof *c, prof_cmp);
+    for (i = 0; i < n && i < top; i++) {
+        uintptr_t k = c[i].key;
+        if (k >= lo && k < hi) {
+            fprintf(stderr, "[EPROF] %s %5.1f%%  exe+%06llX\n", what, 100.0 * c[i].n / total,
+                    (unsigned long long)(k - lo));
+        } else {
+            char path[MAX_PATH] = "?";
+            HMODULE m = NULL;
+            if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                   GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (LPCSTR)k, &m) && m)
