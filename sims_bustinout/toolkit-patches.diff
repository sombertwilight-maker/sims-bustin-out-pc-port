+typedef struct { uint32_t tid, ord, a0, site; uint64_t n, ns, max; } KStat;
+static KStat s_kst[512];
+static volatile LONG s_kst_lock;
+static int s_kst_on = -1, s_kst_period = 10;
+static LARGE_INTEGER s_kst_freq, s_kst_last;
+static int kst_cmp(const void *a, const void *b)
+{
+    const KStat *x = (const KStat *)a, *y = (const KStat *)b;
+    return x->ns < y->ns ? 1 : x->ns > y->ns ? -1 : 0;
+}
+static void kst_note(uint32_t ord, uint32_t a0, uint32_t site, LONGLONG ticks)
+{
+    uint32_t tid = GetCurrentThreadId(), h = (tid * 31u + ord * 7u + a0 * 13u + site) & 511u;
+    uint64_t ns = (uint64_t)((double)ticks * 1e9 / (double)s_kst_freq.QuadPart);
+    LARGE_INTEGER now;
+    int i;
+    while (InterlockedExchange(&s_kst_lock, 1)) YieldProcessor();
+    for (i = 0; i < 512; i++, h = (h + 1) & 511u) {
+        KStat *k = &s_kst[h];
+        if (!k->n) { k->tid = tid; k->ord = ord; k->a0 = a0; k->site = site; }
+        if (k->tid == tid && k->ord == ord && k->a0 == a0 && k->site == site) {
+            k->n++; k->ns += ns; if (ns > k->max) k->max = ns;
+            break;
+        }
+    }
+    QueryPerformanceCounter(&now);
+    if (now.QuadPart - s_kst_last.QuadPart > s_kst_period * s_kst_freq.QuadPart) {
+        static KStat copy[512];
+        int n = 0;
+        for (i = 0; i < 512; i++) if (s_kst[i].n) copy[n++] = s_kst[i];
+        memset(s_kst, 0, sizeof s_kst);
+        s_kst_last = now;
+        InterlockedExchange(&s_kst_lock, 0);
+        qsort(copy, n, sizeof *copy, kst_cmp);
+        fprintf(stderr, "[KSTATS] %d entries\n", n);
+        for (i = 0; i < n && i < (s_kst_period > 2 ? 10 : 16); i++)
